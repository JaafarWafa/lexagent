# Any OpenAI-compatible endpoint (Ollama, Groq, Mistral, OpenAI...)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b-instruct
API_URL=http://localhost:8000
# Hybrid retrieval. Leave empty for BM25 only. Downloaded once (~120 MB) on first upload.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Optional tracing with Langfuse (cloud or self-hosted). Empty = off.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
