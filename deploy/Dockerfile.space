# Hugging Face Spaces (Docker SDK): copy this file to the Space repo as `Dockerfile`.
# Space secrets to set: LLM_API_KEY (and optionally LLM_BASE_URL, LLM_MODEL, LANGFUSE_*).
FROM python:3.11-slim
RUN useradd -m -u 1000 user
WORKDIR /home/user/app
ENV PYTHONUNBUFFERED=1 HF_HUB_DISABLE_XET=1 FASTEMBED_CACHE_PATH=/home/user/models PORT=7860 \
    LLM_BASE_URL=https://api.groq.com/openai/v1 LLM_MODEL=openai/gpt-oss-120b
COPY --chown=user requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
USER user
RUN python -c "from fastembed import TextEmbedding; TextEmbedding('sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2')"
COPY --chown=user . .
EXPOSE 7860
CMD ["sh", "deploy/start.sh"]
